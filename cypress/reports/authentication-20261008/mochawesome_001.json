              "fail": false,
              "pending": false,
              "context": null,
              "code": "cy.env(['SAUCE_PASSWORD']).then(({\n  SAUCE_PASSWORD\n}) => {\n  if (!SAUCE_PASSWORD) {\n    throw new Error('Set SAUCE_PASSWORD for the locked-account scenario.');\n  }\n  // SauceDemo publishes demo accounts on its login page; do not copy them into fixtures.\n  cy.get('[data-test=\"login-credentials\"]', {\n    log: false\n  }).then($credentials => {\n    const lockedUsername = $credentials[0].innerText.split(/\\s+/).find(value => value.includes('locked'));\n    if (!lockedUsername) {\n      throw new Error('The SauceDemo login page must publish a locked demo account.');\n    }\n    cy.LoginPom(lockedUsername, SAUCE_PASSWORD);\n    // SauceDemo sets this cookie before checking whether the user is locked.\n    expectLoginError('Epic sadface: Sorry, this user has been locked out.', lockedUsername);\n    cy.visit('/inventory.html', {\n      failOnStatusCode: false\n    });\n    expectLoginError(inventoryAccessMessage, lockedUsername);\n  });\n});",
